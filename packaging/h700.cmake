set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER aarch64-nextui-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-nextui-linux-gnu-g++)
set(CMAKE_SYSROOT /opt/aarch64-nextui-linux-gnu/aarch64-nextui-linux-gnu/libc)
set(CMAKE_FIND_ROOT_PATH ${CMAKE_SYSROOT} /opt/nextui /src/.build/prefix)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
